{
  "name": "GetOrderShipmentTracking",
  "method": "POST",
  "path": "/message/GetOrderShipmentTracking",
  "description": "Returns the shipment tracking state of an order\u0027s parcels (shipments): progress steps\n(previous, current and future), alerts, estimated delivery windows, carrier information,\ntracking links, delivery location and items \u2014 everything needed to render a tracking\ncomponent without further logic.\n\nThe state is fed by carrier tracking webhooks and served as persisted; \u0060LastUpdated\u0060\nindicates the freshness per parcel. When tracking is not configured or no tracking data\nexists for the order, \u0060TrackingAvailable\u0060 is \u0060false\u0060 and \u0060Parcels\u0060 is empty \u2014 this is not\nan error.",
  "auth_description": "This service does not require authentication.",
  "headers": [
    {
      "name": "EVA-User-Agent",
      "type": "string",
      "description": "The user agent that is making these calls. Don\u0027t make this specific per device/browser but per application. This should be of the form: \u0060MyFirstUserAgent/1.0.0\u0060",
      "required": true,
      "default": null
    },
    {
      "name": "EVA-Requested-OrganizationUnitID",
      "type": "integer",
      "description": "The ID of the organization unit to run this request in.",
      "required": false,
      "default": null
    },
    {
      "name": "EVA-Requested-OrganizationUnit-Query",
      "type": "string",
      "description": "The query that selects the organization unit to run this request in.",
      "required": false,
      "default": null
    },
    {
      "name": "EVA-IDs-Mode",
      "type": "string",
      "description": "The IDs mode to run this request in. Currently only \u0060ExternalIDs\u0060 is supported.",
      "required": false,
      "default": null
    },
    {
      "name": "EVA-IDs-BackendSystemID",
      "type": "string",
      "description": "The ID of the backend system that is used to resolve the IDs.",
      "required": false,
      "default": null
    }
  ],
  "request_samples": [
    {
      "name": "JSON",
      "sample": "{\n  \u0022Locale\u0022: \u0022string\u0022,\n  \u0022OrderID\u0022: 123,\n  \u0022ShipmentID\u0022: 123\n}",
      "syntax": "json"
    },
    {
      "name": "CURL",
      "sample": "curl -H \u0022Content-Type: application/json\u0022 \\\n  -H \u0022EVA-User-Agent: MyFirstUserAgent/1.0.0\u0022 \\\n  -H \u0022Authorization: Bearer \u003Ctoken\u003E\u0022 \\\n  --data \u0027{\n  \u0022Locale\u0022: \u0022string\u0022,\n  \u0022OrderID\u0022: 123,\n  \u0022ShipmentID\u0022: 123\n}\u0027 \\\n  https://euw.acme.test.eva-online.cloud/message/GetOrderShipmentTracking",
      "syntax": "bash"
    }
  ],
