    {
      "name": "200",
      "sample": "{\n  \u0022Parcels\u0022: [\n    {\n      \u0022LastUpdated\u0022: \u00222025-01-01\u0022,\n      \u0022ShipmentID\u0022: 123,\n      \u0022State\u0022: {\n        \u0022Alerts\u0022: [\n          {\n            \u0022Timestamp\u0022: \u00222025-01-01\u0022,\n            \u0022Type\u0022: 2\n          }\n        ],\n        \u0022CarrierDisplayName\u0022: \u0022string\u0022,\n        \u0022CarrierLogoUrl\u0022: \u0022string\u0022,\n        \u0022CarrierTrackingUrl\u0022: \u0022string\u0022,\n        \u0022CurrentStep\u0022: 11,\n        \u0022DeliveryType\u0022: 1,\n        \u0022Direction\u0022: 1,\n        \u0022EstimatedDeliveryWindow\u0022: {\n          \u0022End\u0022: \u00222025-01-01\u0022,\n          \u0022Start\u0022: \u00222025-01-01\u0022\n        },\n        \u0022Items\u0022: [\n          {\n            \u0022Name\u0022: \u0022string\u0022,\n            \u0022Quantity\u0022: 123\n          }\n        ],\n        \u0022Location\u0022: {\n          \u0022AddressLines\u0022: [\n            \u0022string\u0022\n          ],\n          \u0022City\u0022: \u0022string\u0022,\n          \u0022CountryID\u0022: \u0022string\u0022,\n          \u0022Latitude\u0022: 123.456,\n          \u0022LocationType\u0022: \u0022string\u0022,\n          \u0022Longitude\u0022: 123.456,\n          \u0022Name\u0022: \u0022string\u0022,\n          \u0022OperationalHours\u0022: {\n            \u0022FreeText\u0022: [\n              \u0022string\u0022\n            ],\n            \u0022Friday\u0022: \u0022string\u0022,\n            \u0022Monday\u0022: \u0022string\u0022,\n            \u0022Saturday\u0022: \u0022string\u0022,\n            \u0022Sunday\u0022: \u0022string\u0022,\n            \u0022Thursday\u0022: \u0022string\u0022,\n            \u0022Tuesday\u0022: \u0022string\u0022,\n            \u0022Wednesday\u0022: \u0022string\u0022\n          },\n          \u0022PickupInstructions\u0022: \u0022string\u0022,\n          \u0022PostalCode\u0022: \u0022string\u0022\n        },\n        \u0022SiteName\u0022: \u0022string\u0022,\n        \u0022Steps\u0022: [\n          {\n            \u0022DisplayText\u0022: \u0022string\u0022,\n            \u0022EstimatedWindow\u0022: {\n              \u0022End\u0022: \u00222025-01-01\u0022,\n              \u0022Start\u0022: \u00222025-01-01\u0022\n            },\n            \u0022IsCurrent\u0022: true,\n            \u0022IsReached\u0022: true,\n            \u0022RawStep\u0022: \u0022string\u0022,\n            \u0022ReachedTime\u0022: \u00222025-01-01\u0022,\n            \u0022Step\u0022: 11\n          }\n        ],\n        \u0022TrackingNumber\u0022: \u0022string\u0022,\n        \u0022TrackingPortalUrl\u0022: \u0022string\u0022\n      }\n    }\n  ],\n  \u0022TrackingAvailable\u0022: true\n}"
